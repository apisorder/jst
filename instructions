#	install the Node Package Manager
sudo apt install npm
#	which is used to install Yarn
sudo install -g yarn
#	add the necessary node modules (libraries, etc.)
sudo npm install
#	in some cases, the project can't start, so update NPM as a preventative measure
sudo npm update
#	run the project
sudo yarn start

Note sudo is likely optional, except with the first two commands

WINDOWS/mac OSX/ Linux  HOST
	set NODE_OPTIONS=--openssl-legacy-provider && yarn start
